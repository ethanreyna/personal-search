{
  "name": "personal-search",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:client && wrangler dev",
    "build:client": "pnpm --filter client build",
    "deploy": "pnpm run build:client && wrangler d1 migrations apply personal-search-db --remote && wrangler deploy",
    "secrets": "echo 'Run: wrangler secret put INVITE_CODE | APIFY_TOKEN | HUNTER_API_KEY | ANTHROPIC_API_KEY | ADZUNA_APP_ID | ADZUNA_APP_KEY | RAPIDAPI_KEY'",
    "typecheck": "tsc --noEmit -p .",
    "db:migrate:local": "wrangler d1 migrations apply personal-search-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply personal-search-db --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.5.4",
    "wrangler": "^4.4.0"
  },
  "packageManager": "pnpm@9.12.0"
}
